# Copy this file to .env and fill in your values. .env is gitignored.

# "production" or "demo"
KALSHI_ENV=production

# The Key ID (UUID) shown when you created your API key on kalshi.com
KALSHI_API_KEY_ID=

# Path to the RSA private key file downloaded when you created the API key.
# Can point at the same key file server/ uses, e.g. ../server/keys/your-key.pem
KALSHI_PRIVATE_KEY_PATH=

# How many open markets to track concurrently. Start modest -- see
# future.md and the collector plan for why breadth is bounded by the
# free-tier egress budget, not guessed up front.
COLLECTOR_MARKET_COUNT=20

# How often (ms) to re-scan for newly-opened/closed markets.
COLLECTOR_DISCOVERY_INTERVAL_MS=1200000

# Feature-snapshot cadence (ms). Deliberately not 4Hz -- 1000 (1Hz) is
# already finer than the 5s/30s/60s markout horizons need.
COLLECTOR_SNAPSHOT_INTERVAL_MS=1000

# Where raw/ and labeled/ log trees are written.
COLLECTOR_OUTPUT_DIR=./data

# Soft cap (GB) on the raw event log before oldest days get pruned.
COLLECTOR_MAX_RAW_LOG_GB=20
