# Copy this file to .env and fill in your values. .env is gitignored.

# "production" or "demo"
KALSHI_ENV=production

# The Key ID (UUID) shown when you created your API key on kalshi.com
KALSHI_API_KEY_ID=

# Path to the RSA private key file downloaded when you created the API key.
# Put the .pem/.key file in server/keys/ (that folder is gitignored).
KALSHI_PRIVATE_KEY_PATH=./keys/kalshi-private-key.pem

# Port the local relay server (that the web frontend connects to) listens on
PORT=8787
